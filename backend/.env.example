# Langfuse (OTLP trace export). Either set the full OTLP endpoint explicitly,
# or set the base URL and it will be derived as {base}/api/public/otel/v1/traces.
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
# LANGFUSE_OTEL_ENDPOINT="https://us.cloud.langfuse.com/api/public/otel/v1/traces"
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."

# Sentry error tracking (optional; export is skipped if unset).
SENTRY_DSN=""

# Anthropic (LLM behind /ask). ANTHROPIC_MODEL defaults to claude-opus-4-8.
ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-opus-4-8"
# Verification (consistency + judge) runs on a cheaper model; defaults to Haiku.
# VERIDATA_VERIFY_MODEL="claude-haiku-4-5-20251001"

# Where per-question run records are written (defaults to backend/run_records).
# VERIDATA_RUN_RECORDS_DIR="run_records"
