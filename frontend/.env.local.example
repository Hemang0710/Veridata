# Backend base URL the app talks to. Defaults to http://localhost:8000 if unset.
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"

# Supabase (client-side auth). Only the public URL and anon key belong in the
# browser — the service-role key and JWT secret are backend-only.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
